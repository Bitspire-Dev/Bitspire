# Publiczne zmienne — dostępne w przeglądarce
NEXT_PUBLIC_SITE_URL=https://bitspire.pl
NEXT_PUBLIC_TINA_CLIENT_ID=

# TinaCMS (serwer + CLI)
TINA_TOKEN=
TINA_PUBLIC_IS_LOCAL=true

# Opcjonalne / wdrożeniowe zmienne dla brancha TinaCMS
TINA_BRANCH=main
GITHUB_BRANCH=
VERCEL_GIT_COMMIT_REF=
HEAD=

# Resend — wysyłka formularza kontaktowego
RESEND_API_KEY=
RESEND_FROM_EMAIL=Bitspire <kontakt@bitspire.pl>
RESEND_TO_EMAIL=kontakt@bitspire.pl
